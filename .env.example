# ValuAgent Configuration

# Your Google Gemini API Key from https://aistudio.google.com/apikey
# google-adk automatically uses GEMINI_API_KEY or GOOGLE_API_KEY.
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) Override the model used by the Memo Writer Agent.
# Default: gemini-2.0-flash (fast, supports free tier with RPM limits).
# Stable free-tier alternative: gemini-1.5-flash
# VALUAGENT_MEMO_MODEL="gemini-1.5-flash"
